*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*& Form test_api
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM test_api .

    cl_http_client=>create_by_destination(
    EXPORTING
      destination = 'Z_ROUTING_API'
    IMPORTING
      client      = lo_client
    EXCEPTIONS
      argument_not_found = 1
      plugin_not_active  = 2
      internal_error     = 3
      others             = 4 ).

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.


  lo_client->propertytype_accept_cookie =
    if_http_client=>co_enabled.

   " GET request - Fetch CSRF token
  "------------------------------------------------------------

  lo_client->request->set_method( 'GET' ).

  lo_client->request->set_header_field(
    name  = 'X-CSRF-Token'
    value = 'Fetch' ).

  lo_client->request->set_header_field(
    name  = 'Accept'
    value = 'application/json' ).


  " Operation URI
  "------------------------------------------------------------

  lo_client->request->set_header_field(
    name  = '~request_uri'
    value =
      '/ProductionRoutingOperation(' &&
      'ProductionRoutingGroup=''50095176'',' &&
      'ProductionRouting=''1'',' &&
      'ProductionRoutingSequence=''0'',' &&
      'ProductionRoutingOpIntID=''1'',' &&
      'ProductionRoutingOpIntVersion=''1''' &&
      ')' ).

   " Send
  "------------------------------------------------------------

  lo_client->send(
    EXCEPTIONS
      http_communication_failure = 1
      http_invalid_state         = 2
      http_processing_failed     = 3
      others                     = 4 ).

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.


 " Receive
  "------------------------------------------------------------

  lo_client->receive(
    EXCEPTIONS
      http_communication_failure = 1
      http_invalid_state         = 2
      http_processing_failed     = 3
      others                     = 4 ).

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.


 " CSRF token
  "------------------------------------------------------------

  lv_csrf_token =
    lo_client->response->get_header_field(
      'X-CSRF-Token' ).


" HTTP status
  "------------------------------------------------------------

  lo_client->response->get_status(
    IMPORTING
      code   = lv_status_code
      reason = lv_status_reason ).

 " Response
  "------------------------------------------------------------

  lv_response = lo_client->response->get_cdata( ).


  /ui2/cl_json=>deserialize(
    EXPORTING
      json = lv_response
    CHANGING
      data = ls_response ).

  lo_client->request->set_cdata( '' ).

    " Test data
  "------------------------------------------------------------

WRITE: / 'Excel rows uploaded:', lines( gt_excel_data ).


DATA ls_excel TYPE ty_excel_data.

*READ TABLE gt_excel_data
*  INDEX 1
*  INTO ls_excel.

*  DATA(ls_excel) = VALUE ty_excel_data(
*
*    group           = '50095176'
*    material        = '10P29724140BW15J0'
*    plant           = 'UP01'
*    operation       = '0010'
*
*    base_quantity   = '6000'
*
*    activity_type1  = 'SET01'
*    unit1           = 'H'
*    standard_value1 = '0.010'
*
*    activity_type2  = 'MAC01'
*    unit2           = 'H'
*    standard_value2 = '1'
*
*    activity_type3  = 'LAB01'
*    unit3           = 'H'
*    standard_value3 = '1'
*
*    activity_type4  = 'TOOL01'
*    unit4           = 'H'
*    standard_value4 = '1'
*
*    activity_type5  = 'MISC01'
*    unit5           = 'H'
*    standard_value5 = '1'
*  ).


LOOP AT gt_excel_data INTO ls_excel.

  CLEAR ls_routing.

  PERFORM get_routing_operation USING ls_excel.

  IF ls_routing-productionroutinggroup IS INITIAL.

    WRITE: / 'Skipping - routing operation not found:',
             ls_excel-material.

    CONTINUE.

  ENDIF.

  PERFORM compare_values USING ls_excel.


  IF lv_update_required = abap_true.

    PERFORM patch_operation USING ls_excel.

  ENDIF.

ENDLOOP.
  lo_client->close( ).


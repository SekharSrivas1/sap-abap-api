*&---------------------------------------------------------------------*
*& Form patch_operation
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> LS_EXCEL
*&---------------------------------------------------------------------*
FORM patch_operation  USING    ps_excel TYPE ty_excel_data.

 DATA:
    lo_client    TYPE REF TO if_http_client,
    lv_uri       TYPE string,
    lv_patch_json TYPE string.

  "------------------------------------------------------------
  " 1. Build the PATCH URI
  "------------------------------------------------------------

  lv_uri =
    |/ProductionRoutingOperation(ProductionRoutingGroup='{ ls_routing-productionroutinggroup }',| &&
    |ProductionRouting='{ ls_routing-productionrouting }',| &&
    |ProductionRoutingSequence='{ ls_routing-productionroutingsequence }',| &&
    |ProductionRoutingOpIntID='{ ls_routing-productionroutingopintid }',| &&
    |ProductionRoutingOpIntVersion='{ ls_routing-productionroutingopintversion }')|.

  "------------------------------------------------------------
  " 2. Hardcoded test payload
  "------------------------------------------------------------

  lv_patch_json =
     |\{"OperationReferenceQuantity":"{ ps_excel-base_quantity }",| &&

     |"CostCtrActivityType1":"{ ps_excel-activity_type1 }",| &&
     |"StandardWorkQuantityUnit1":"{ ps_excel-unit1 }",| &&
     |"StandardWorkQuantity1":"{ ps_excel-standard_value1 }",| &&


     |"CostCtrActivityType2":"{ ps_excel-activity_type2 }",| &&
     |"StandardWorkQuantityUnit2":"{ ps_excel-unit2 }",| &&
     |"StandardWorkQuantity2":"{ ps_excel-standard_value2 }",| &&

     |"CostCtrActivityType3":"{ ps_excel-activity_type3 }",| &&
     |"StandardWorkQuantityUnit3":"{ ps_excel-unit3 }",| &&
     |"StandardWorkQuantity3":"{ ps_excel-standard_value3 }",| &&

     |"CostCtrActivityType4":"{ ps_excel-activity_type4 }",| &&
     |"StandardWorkQuantityUnit4":"{ ps_excel-unit4 }",| &&
     |"StandardWorkQuantity4":"{ ps_excel-standard_value4 }",| &&

     |"CostCtrActivityType5":"{ ps_excel-activity_type5 }",| &&
     |"StandardWorkQuantityUnit5":"{ ps_excel-unit5 }",| &&
     |"StandardWorkQuantity5":"{ ps_excel-standard_value5 }"\}|.


  "------------------------------------------------------------
  " 3. Create HTTP client
  "------------------------------------------------------------

  cl_http_client=>create_by_destination(
    EXPORTING
      destination = 'Z_ROUTING_API'
    IMPORTING
      client      = lo_client
    EXCEPTIONS
      argument_not_found = 1
      plugin_not_active  = 2
      internal_error     = 3
      others             = 4 ).

  IF sy-subrc <> 0.

    WRITE: / 'ERROR: HTTP client could not be created'.

    RETURN.

  ENDIF.

  "------------------------------------------------------------
  " 4. Enable cookies
  "------------------------------------------------------------

  lo_client->propertytype_accept_cookie =
    if_http_client=>co_enabled.

  "------------------------------------------------------------
  " 5. Fetch CSRF token
  "------------------------------------------------------------

  lo_client->request->set_method( 'GET' ).

  lo_client->request->set_header_field(
    name  = '~request_uri'
    value = '/sap/opu/odata/sap/API_PRODUCTION_ROUTING;v=3/ProductionRoutingOperation' ).
*    value = '/ProductionRoutingOperation' ).

  lo_client->request->set_header_field(
    name  = 'Accept'
    value = 'application/json' ).

  lo_client->request->set_header_field(
    name  = 'X-CSRF-Token'
    value = 'Fetch' ).

  lo_client->send( ).
  lo_client->receive( ).

  lo_client->response->get_status(
    IMPORTING
      code   = lv_status_code
      reason = lv_status_reason ).

  lv_csrf_token =
    lo_client->response->get_header_field(
      'X-CSRF-Token' ).

  WRITE: / 'CSRF STATUS:', lv_status_code.
  WRITE: / 'CSRF REASON:', lv_status_reason.
  WRITE: / 'CSRF TOKEN :', lv_csrf_token.

  IF lv_csrf_token IS INITIAL.

    WRITE: / 'ERROR: CSRF token not received'.

    lo_client->close( ).

    RETURN.

  ENDIF.

  "------------------------------------------------------------
  " 6. Prepare PATCH
  "------------------------------------------------------------

  lo_client->request->set_method( 'PATCH' ).

  lo_client->request->set_header_field(
    name  = '~request_uri'
    value = |/sap/opu/odata/sap/API_PRODUCTION_ROUTING;v=3{ lv_uri }| ).
*    value = lv_uri ).

  lo_client->request->set_header_field(
    name  = 'Content-Type'
    value = 'application/json' ).

  lo_client->request->set_header_field(
    name  = 'Accept'
    value = 'application/json' ).

  lo_client->request->set_header_field(
    name  = 'If-Match'
    value = '*' ).

  lo_client->request->set_header_field(
    name  = 'X-CSRF-Token'
    value = lv_csrf_token ).

  lo_client->request->set_cdata(
    lv_patch_json ).

  "------------------------------------------------------------
  " 7. Debug information
  "------------------------------------------------------------

  WRITE: / '--------------------------------------------'.
  WRITE: / 'PATCH DEBUG'.
  WRITE: / '--------------------------------------------'.

  WRITE: / 'URI:'.
  WRITE: / lv_uri.

  WRITE: / 'JSON:', lv_patch_json.

  WRITE: / 'IF-MATCH: *'.

  "------------------------------------------------------------
  " 8. Send PATCH
  "------------------------------------------------------------

  lo_client->send( ).
  lo_client->receive( ).

  lo_client->response->get_status(
    IMPORTING
      code   = lv_status_code
      reason = lv_status_reason ).

  lv_response =
    lo_client->response->get_cdata( ).

  "------------------------------------------------------------
  " 9. Display result
  "------------------------------------------------------------

  WRITE: / '--------------------------------------------'.
  WRITE: / 'PATCH RESULT'.
  WRITE: / '--------------------------------------------'.

  WRITE: / 'STATUS:', lv_status_code.
  WRITE: / 'REASON:', lv_status_reason.

  IF lv_response IS NOT INITIAL.

    WRITE: / 'RESPONSE:'.
    WRITE: / lv_response.

  ENDIF.

  IF lv_status_code = 204.

    WRITE: / 'UPDATE SUCCESSFUL'.

  ELSE.

    WRITE: / 'UPDATE FAILED'.

  ENDIF.

  "------------------------------------------------------------
  " 10. Close HTTP client
  "------------------------------------------------------------

  lo_client->close( ).


ENDFORM.



